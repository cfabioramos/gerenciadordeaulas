# Gerenciador de Aulas - Variáveis de Ambiente Docker

# ===============================
# SERVIDOR
# ===============================
APP_PORT=8080

# ===============================
# BANCO DE DADOS
# ===============================
DB_NAME=gerenciadordeaulas
DB_USER=postgres
DB_PASSWORD=postgres123
